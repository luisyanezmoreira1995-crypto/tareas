@model VehiculoCreateDto
@{
    ViewData["Title"] = "Editar vehículo";
}

<h1>Editar vehículo</h1>

<form asp-action="Edit" asp-route-id="@ViewBag.Id" method="post">
    <div class="mb-3">
        <label class="form-label">Placa</label>
        <input asp-for="Placa" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Marca</label>
        <input asp-for="Marca" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Modelo</label>
        <input asp-for="Modelo" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Año</label>
        <input asp-for="Anio" class="form-control" type="number" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Color</label>
        <input asp-for="Color" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Tarifa diaria</label>
        <input asp-for="TarifaDiaria" class="form-control" type="number" step="0.01" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Estado</label>
        <select asp-for="Estado" class="form-select" asp-items="Html.GetEnumSelectList<EstadoVehiculo>()"></select>
    </div>
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
</form>
