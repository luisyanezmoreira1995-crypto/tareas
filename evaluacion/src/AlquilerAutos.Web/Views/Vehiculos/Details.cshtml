@model VehiculoDto
@{
    ViewData["Title"] = "Detalle del vehículo";
}

<h1>@Model.Marca @Model.Modelo</h1>

<dl class="row">
    <dt class="col-sm-3">Placa</dt>
    <dd class="col-sm-9">@Model.Placa</dd>
    <dt class="col-sm-3">Año</dt>
    <dd class="col-sm-9">@Model.Anio</dd>
    <dt class="col-sm-3">Color</dt>
    <dd class="col-sm-9">@Model.Color</dd>
    <dt class="col-sm-3">Tarifa diaria</dt>
    <dd class="col-sm-9">@Model.TarifaDiaria.ToString("C")</dd>
    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9">@Model.Estado</dd>
</dl>

<a class="btn btn-secondary" asp-action="Index">Volver</a>
