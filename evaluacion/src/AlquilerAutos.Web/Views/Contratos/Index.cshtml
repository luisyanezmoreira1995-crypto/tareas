@model List<ContratoDto>
@{
    ViewData["Title"] = "Contratos";
}

<h1>Contratos</h1>

<p><a class="btn btn-primary" asp-action="Create">Nuevo contrato</a></p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Cliente</th>
            <th>Vehículo</th>
            <th>Inicio</th>
            <th>Fin</th>
            <th>Estado</th>
            <th>Total</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.ClienteNombre</td>
                <td>@c.VehiculoDescripcion</td>
                <td>@c.FechaInicio.ToString("yyyy-MM-dd")</td>
                <td>@c.FechaFin.ToString("yyyy-MM-dd")</td>
                <td>@c.Estado</td>
                <td>@c.Total.ToString("C")</td>
                <td>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@c.Id">Ver</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.Id">Editar</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@c.Id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
