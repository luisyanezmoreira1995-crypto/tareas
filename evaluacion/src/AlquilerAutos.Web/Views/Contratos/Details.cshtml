@model ContratoDto
@{
    ViewData["Title"] = "Detalle del contrato";
}

<h1>Contrato #@Model.Id</h1>

<dl class="row">
    <dt class="col-sm-3">Cliente</dt>
    <dd class="col-sm-9">@Model.ClienteNombre</dd>
    <dt class="col-sm-3">Vehículo</dt>
    <dd class="col-sm-9">@Model.VehiculoDescripcion</dd>
    <dt class="col-sm-3">Fecha inicio</dt>
    <dd class="col-sm-9">@Model.FechaInicio.ToString("yyyy-MM-dd")</dd>
    <dt class="col-sm-3">Fecha fin</dt>
    <dd class="col-sm-9">@Model.FechaFin.ToString("yyyy-MM-dd")</dd>
    <dt class="col-sm-3">Fecha devolución real</dt>
    <dd class="col-sm-9">@(Model.FechaDevolucionReal?.ToString("yyyy-MM-dd") ?? "-")</dd>
    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9">@Model.Estado</dd>
    <dt class="col-sm-3">Total</dt>
    <dd class="col-sm-9">@Model.Total.ToString("C")</dd>
    <dt class="col-sm-3">Observaciones</dt>
    <dd class="col-sm-9">@Model.Observaciones</dd>
</dl>

<a class="btn btn-secondary" asp-action="Index">Volver</a>
<a class="btn btn-outline-primary" asp-controller="Pagos" asp-action="Create" asp-route-contratoId="@Model.Id">Registrar pago</a>
