@model AlquilerAutos.Web.Models.PagoCreateViewModel
@{
    ViewData["Title"] = "Nuevo pago";
}

<h1>Nuevo pago</h1>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label class="form-label">Contrato</label>
        <select asp-for="Pago.ContratoId" class="form-select">
            <option value="">-- Seleccione --</option>
            @foreach (var c in Model.Contratos)
            {
                <option value="@c.Id">#@c.Id - @c.ClienteNombre - @c.VehiculoDescripcion</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Fecha de pago</label>
        <input asp-for="Pago.FechaPago" class="form-control" type="date" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Monto</label>
        <input asp-for="Pago.Monto" class="form-control" type="number" step="0.01" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Método de pago</label>
        <select asp-for="Pago.MetodoPago" class="form-select" asp-items="Html.GetEnumSelectList<MetodoPago>()"></select>
    </div>
    <div class="mb-3">
        <label class="form-label">Referencia</label>
        <input asp-for="Pago.Referencia" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
</form>
