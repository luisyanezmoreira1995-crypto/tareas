@model Cliente

@{
    ViewData["Title"] = "Eliminar Cliente";
}

<h1>¿Eliminar este cliente?</h1>

<dl class="row">
    <dt class="col-sm-2">Nombres</dt>
    <dd class="col-sm-10">@Model.Nombres</dd>
    <dt class="col-sm-2">Apellidos</dt>
    <dd class="col-sm-10">@Model.Apellidos</dd>
    <dt class="col-sm-2">Dirección</dt>
    <dd class="col-sm-10">@Model.Direccion</dd>
    <dt class="col-sm-2">Teléfono</dt>
    <dd class="col-sm-10">@Model.Telefono</dd>
    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.Email</dd>
    <dt class="col-sm-2">RUC</dt>
    <dd class="col-sm-10">@Model.Ruc</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
